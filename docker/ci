#!/bin/sh
# Every check a change must pass, in order, each in a throwaway container of the development image (docker/tooling).
# The exit status is the first failing step's; only the dependency installation and the advisory lookup use the
# network.
#
#   sh docker/ci                  # everything
#   sh docker/ci static           # the dependencies' checks, lint, PHPCS, PHP-CS-Fixer, PHPStan
#   sh docker/ci unit             # the unit suite
#   sh docker/ci integration      # the integration suite, on the disposable MariaDB of docker/compose.test.yml
#   sh docker/ci mutation         # mutation testing (docker/mutation): the tests held to the thresholds of infection.json5
set -eu

project_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$project_dir"
what=${1:-all}

case "$what" in
    all | static | unit | integration | mutation) ;;
    *)
        echo 'Usage: sh docker/ci [all|static|unit|integration|mutation]' >&2
        exit 1
        ;;
esac

step() {
    printf '\n==> %s\n' "$1"
}

# AMPF_KIT_AMPF_CHECKOUT (docker/mounts.sh) reaches every step through docker/tooling
if [ -n "${AMPF_KIT_AMPF_CHECKOUT:-}" ]; then
    printf '\n==> ampf: the unreleased checkout %s, read-only over vendor/amp-framework/ampf\n' "$AMPF_KIT_AMPF_CHECKOUT"
fi

step 'composer install (locked)'
sh docker/tooling install --no-progress

if [ "$what" = all ] || [ "$what" = static ]; then
    step 'composer validate'
    sh docker/tooling composer validate --strict --no-check-publish
    step 'composer check-platform-reqs'
    sh docker/tooling composer check-platform-reqs
    step 'composer audit'
    sh docker/tooling audit --locked
    step 'php -l'
    sh docker/tooling sh -c 'find src config tests docker -name "*.php" -print0 | xargs -0 -n 50 php -l >/dev/null'
    step 'phpcs'
    sh docker/tooling composer phpcs
    step 'php-cs-fixer (dry run)'
    sh docker/tooling composer cs:check
    step 'phpstan'
    sh docker/tooling composer phpstan -- --no-progress
fi

if [ "$what" = all ] || [ "$what" = unit ]; then
    step 'phpunit (unit)'
    sh docker/tooling composer test
fi

if [ "$what" = all ] || [ "$what" = integration ]; then
    step 'phpunit (integration, disposable MariaDB)'
    sh docker/test-integration
fi

if [ "$what" = all ] || [ "$what" = mutation ]; then
    step 'mutation testing (Infection, disposable MariaDB)'
    sh docker/mutation
fi

step 'ok'
