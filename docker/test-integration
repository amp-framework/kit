#!/bin/sh
# Runs the integration suite against the disposable MariaDB of docker/compose.test.yml. Arguments go to PHPUnit:
#
#   sh docker/test-integration
#   sh docker/test-integration --filter DisposableDatabaseTest
#
# The database is created fresh in memory and torn down afterwards, with everything else of the stack: nothing here
# can reach a real database. Unreleased ampf and the shared package: docker/mounts.sh.
set -eu

project_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
compose="docker compose -f $project_dir/docker/compose.test.yml"

. "$project_dir/docker/mounts.sh"

cleanup() {
    $compose down --remove-orphans >/dev/null 2>&1 || true
}
trap cleanup EXIT INT TERM

if [ "$#" -eq 0 ]; then
    set -- vendor/bin/phpunit --testsuite integration
else
    set -- vendor/bin/phpunit --testsuite integration "$@"
fi

# shellcheck disable=SC2086 # $mounts is empty or whole options
$compose run --rm --user "$(id -u):$(id -g)" $mounts phpunit "$@"
